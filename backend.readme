│
├── routes/
│   ├── authRoutes.js           # Public API routes
│   ├── userRoutes.js           # Profile configuration routes
│   ├── projectRoutes.js        # Project CRUD endpoints
│   ├── teamRoutes.js           # Team setup and hierarchy endpoints
│   ├── taskRoutes.js           # Task status and update routes
│   ├── analyticsRoutes.js      # Leaderboards and metric endpoints
│   ├── reportRoutes.js         # Export request routes
│   ├── notificationRoutes.js   # Alerts pull endpoints
│   └── activityRoutes.js       # Log tracking query endpoints
│
├── middleware/
