│   ├── roleMiddleware.js       # Checks role validation rules for route access
│   ├── errorMiddleware.js      # Standardized central exception handler
│   └── validationMiddleware.js # Integrates express-validator validations
│
├── validations/                # Schemas for input field sanitization
│
├── utils/                      # Helper methods (date formatters, response templates)
│
├── jobs/                       # Cron configurations (periodic score recalculation)
│
├── logs/                       # Server-side output dump folder
